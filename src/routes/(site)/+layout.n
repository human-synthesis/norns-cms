.min-h-screen.flex.flex-col
	header.site-header
		.site-container.flex.items-center.justify-between.py-5
			a.flex.items-center.gap-3.no-underline(href="/" class="text-fg")
				.logo-mark {data.site.title.slice(0, 1)}
				span.font-extrabold.tracking-tight.text-lg {data.site.title}
			nav.flex.items-center.gap-1
				+each('data.nav as item (item.href)')
					a.nav-link(href!="{item.href}") {item.label}
				+if('data.user')
					a.nav-link(href="/admin") Admin
	main.flex-1.w-full.site-container.py-12
		slot
	footer.site-container.py-8.text-xs(class="text-fg-subtle")
		| {data.site.title} · powered by Norns

<script>
	{ data } := $props()
</script>
