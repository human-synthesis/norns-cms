.space-y-10
	header.space-y-3
		h1.text-4xl.font-bold.tracking-tight Articles
		+if('data.categories.length')
			nav.flex.flex-wrap.gap-2(aria-label="Categories")
				+each('data.categories as c (c.id)')
					a.tag-link(href!="{c.url}") {c.name}
						span.tag-count {c.count}
	+if('data.featured.length')
		section.space-y-4
			h2.text-sm.font-semibold.uppercase.tracking-wide(class="text-fg-subtle") Featured
			.article-grid
				+each('data.featured as a (a.id)')
					ArticleCard(a!="{a}")
	+if('data.entries.length === 0 && data.featured.length === 0')
		p(class="text-fg-muted") No articles yet.
	+else
		.article-grid
			+each('data.entries as a (a.id)')
				ArticleCard(a!="{a}")
	Pager(page!="{data.page}" pages!="{data.pages}" base="/articles")

<script>
	import ArticleCard from '$lib/norns/articles/ui/ArticleCard.n'
	import Pager from '$lib/norns/articles/ui/Pager.n'
	{ data } := $props()
</script>
