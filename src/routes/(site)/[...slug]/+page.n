+if('data.kind === "list"')
	.space-y-8
		h1.text-4xl.font-bold.tracking-tight {data.ct.labelPlural}
		+if('data.entries.length === 0')
			p(class="text-fg-muted") Nothing published yet.
		.space-y-4
			+each('data.entries as e (e.id)')
				Card(href="{data.ct.basePath}/{e.slug}")
					.font-semibold.text-lg {e.title}
					+if('e.data.summary')
						p.text-sm.mt-1(class="text-fg-muted") {e.data.summary}
+elseif('data.kind === "cookies"')
	article.page-view
		h1.page-title Cookies
		CookieTableBlock(props!="{{ title: '', showButton: true }}" data!="{{ declaration: data.declaration }}")
+elseif('data.res.ct.id === "article"')
	ArticleView(res!="{data.res}" extra!="{data.extra}")
+else
	PageView(res!="{data.res}")

<script>
	import PageView from '$lib/norns/pages/ui/PageView.n'
	import ArticleView from '$lib/norns/articles/ui/ArticleView.n'
	import CookieTableBlock from '$lib/norns/consent/ui/CookieTableBlock.n'
	{ data } := $props()
</script>
