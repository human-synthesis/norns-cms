svelte:head
	title {t('register.title')} · {page.data.site.title}
.account-narrow
	h1.text-3xl.font-bold.tracking-tight {t('register.title')}
	+if('form?.registered')
		Banner(variant="success" icon="lucide:mail") {t('register.done', { email: form.registered })}
	+else
		Card
			Form(action="?/register" form!="{form}")
				.space-y-4
					Field(label!="{t('register.name')}" name="name")
						Input(name="name" value!="{form?.values?.name ?? ''}" autocomplete="name")
					Field(label!="{t('login.email')}" name="email" required)
						Input(type="email" name="email" value!="{form?.values?.email ?? ''}" autocomplete="email" required)
					Field(label!="{t('login.password')}" name="password" required help!="{t('register.passwordHelp')}")
						Input(type="password" name="password" autocomplete="new-password" required)
					Field(name="terms")
						label.check-item
							Checkbox(name="terms" value="1")
							span {t('register.terms')} 
								a(href!="{page.data.banner?.policyUrl ?? '/privacy'}") {t('register.policy')}
					FormGuard(id="auth.member-register" form!="{form}")
					Btn(type="submit" variant="primary" class="w-full") {t('register.submit')}
	.text-sm
		a(href="/account/login") {t('register.haveAccount')}

<script>
	import FormGuard from '$lib/norns/protection/ui/FormGuard.n'
	import { page } from '$app/state'
	import { t } from '$lib/norns/i18n/ui/t.js'
	{ form } := $props()
</script>
