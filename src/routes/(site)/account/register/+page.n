.account-narrow
	h1.text-3xl.font-bold.tracking-tight Create an account
	+if('form?.registered')
		Banner(variant="success" icon="lucide:mail") Almost done: we sent a confirmation link to {form.registered}. Open it to finish.
	+else
		Card
			Form(action="?/register" form!="{form}")
				.space-y-4
					Field(label="Name" name="name")
						Input(name="name" value!="{form?.values?.name ?? ''}" autocomplete="name")
					Field(label="Email" name="email" required)
						Input(type="email" name="email" value!="{form?.values?.email ?? ''}" autocomplete="email" required)
					Field(label="Password" name="password" required help="At least 12 characters")
						Input(type="password" name="password" autocomplete="new-password" required)
					Field(name="terms")
						label.check-item
							Checkbox(name="terms" value="1")
							span I agree to the terms and have read the 
								a(href!="{page.data.banner?.policyUrl ?? '/privacy'}") privacy policy
					Btn(type="submit" variant="primary" class="w-full") Create account
	.text-sm
		a(href="/account/login") Already have an account? Sign in

<script>
	import { page } from '$app/state'
	{ form } := $props()
</script>
