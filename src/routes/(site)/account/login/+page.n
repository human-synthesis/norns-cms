svelte:head
	title {t('login.title')} · {page.data.site.title}
.account-narrow
	h1.text-3xl.font-bold.tracking-tight {t('login.title')}
	+if('data.verified')
		Banner(variant="success" icon="lucide:check") {t('login.verified')}
	+if('data.reset')
		Banner(variant="success" icon="lucide:check") {t('login.reset')}
	+if('form?.resent')
		Banner(variant="info" icon="lucide:mail") {t('login.resent')}
	Card
		Form(action="?/login" form!="{form}")
			.space-y-4
				input(type="hidden" name="next" value!="{data.next}")
				Field(label!="{t('login.email')}" name="email" required)
					Input(type="email" name="email" value!="{form?.values?.email ?? ''}" autocomplete="username" required)
				Field(label!="{t('login.password')}" name="password" required)
					Input(type="password" name="password" autocomplete="current-password" required)
				FormGuard(id="auth.member-login" form!="{form}")
				Btn(type="submit" variant="primary" class="w-full") {t('login.submit')}
		+if('form?.unverified')
			form.pt-3(method="POST" action="?/resend")
				input(type="hidden" name="email" value!="{form.values?.email ?? ''}")
				FormGuard(id="auth.member-resend" form!="{form}")
				Btn(type="submit" variant="ghost" size="sm") {t('login.resend')}
	.text-sm.flex.justify-between
		a(href="/account/forgot") {t('login.forgot')}
		+if('page.data.site?.registration === "open"')
			a(href="/account/register") {t('login.register')}

<script>
	import FormGuard from '$lib/norns/protection/ui/FormGuard.n'
	import { page } from '$app/state'
	import { t } from '$lib/norns/i18n/ui/t.js'
	{ data, form } := $props()
</script>
