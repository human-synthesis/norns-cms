svelte:head
	title {t('privacy.title')} · {page.data.site.title}
.account-page
	PageHead(title!="{t('privacy.title')}" back="/account" backLabel!="{t('privacy.back')}")
	Card
		h2.font-semibold.mb-2 {t('privacy.cookies')}
		p.text-sm.mb-3
			+if('data.state.given')
				| {t('privacy.chose', { p: yes(data.state.choice.preferences), a: yes(data.state.choice.analytics), m: yes(data.state.choice.marketing) })}
			+else
				| {t('privacy.noChoice')}
		Btn(variant="secondary" icon="lucide:cookie" onclick!="{openConsent}") {t('privacy.change')}
		+if('data.records.length')
			details.mt-4
				summary.text-sm {t('privacy.recorded')}
				ul.text-xs.space-y-1.pt-2
					+each('data.records as r (r.id)')
						li {fmtDate(r.created_at, { dateStyle: 'medium' })} — {r.action.replace('_', ' ')} (v{r.policy_version})
	Card
		h2.font-semibold.mb-2 {t('privacy.download')}
		p.text-sm.mb-3(class="text-fg-muted") {t('privacy.downloadText')}
		Btn(href="/account/export.json" variant="secondary" icon="lucide:download") {t('privacy.downloadButton')}
	Card
		h2.font-semibold.mb-2 {t('privacy.delete')}
		p.text-sm.mb-4(class="text-fg-muted") {t('privacy.deleteText')}
		Form(action="?/delete" form!="{form}")
			.space-y-4
				Field(label!="{t('login.password')}" name="password" required)
					Input(type="password" name="password" autocomplete="current-password")
				Field(label!="{t('privacy.typeDelete')}" name="confirm" required)
					Input(name="confirm" autocomplete="off")
				Btn(type="submit" variant="danger" icon="lucide:trash-2") {t('privacy.deleteButton')}

<script>
	import { page } from '$app/state'
	import { t, fmtDate } from '$lib/norns/i18n/ui/t.js'
	{ data, form } := $props()
	yes := (b) => b ? t('privacy.yes') : t('privacy.no')
	openConsent := => window.dispatchEvent(new CustomEvent('cms:open-consent'))
</script>
