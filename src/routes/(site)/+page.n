+if('data.kind === "page"')
	PageView(res!="{data.res}")
+else
	section.home-intro
		h1.text-5xl.font-bold.tracking-tight.leading-none {data.site.title}
		+if('data.site.tagline')
			p.text-lg.max-w-prose(class="text-fg-muted") {data.site.tagline}
	section.pt-10.space-y-6
		h2.text-xl.font-semibold Latest articles
		+if('data.articles.length === 0')
			Banner(variant="info" icon="lucide:info") No articles yet.
		+else
			.article-grid
				+each('data.articles as a (a.id)')
					ArticleCard(a!="{a}")
			+if('data.more')
				a(href="/articles") All articles →

<script>
	import PageView from '$lib/norns/pages/ui/PageView.n'
	import ArticleCard from '$lib/norns/articles/ui/ArticleCard.n'
	{ data } := $props()
</script>
