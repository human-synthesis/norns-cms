.space-y-6
	PageHead(title="Roles" subtitle="Built-in roles are fixed; custom roles pick any capabilities the installed features declare.")
		+snippet('actions')
			Btn(href="/admin/roles/new" variant="primary" icon="lucide:plus") New role
	.grid.gap-4(class="md:grid-cols-2")
		+each('data.roles as r (r.id)')
			Card(href="/admin/roles/{r.id}")
				.flex.items-start.justify-between.gap-3
					div
						.font-semibold {r.label}
						p.text-sm(class="text-fg-muted") {r.description || '—'}
					.flex.gap-1
						Badge(size="sm") {r.kind === 'staff' ? 'staff' : 'members'}
						+if('r.builtin')
							Badge(size="sm" variant="info") built-in
				.text-xs.mt-2(class="text-fg-subtle") {r.users} user{r.users === 1 ? '' : 's'} · {r.capabilities.includes('*') ? 'all capabilities' : r.capabilities.length + ' capabilities'}

<script>
	{ data } := $props()
</script>
