.space-y-8
	div
		h1.text-2xl.font-bold.tracking-tight Dashboard
		p.text-sm(class="text-fg-muted") Welcome back, {data.user.name || data.user.email}.
	.stat-grid
		+each('data.counts as c (c.ct.id)')
			Stat(label!="{c.ct.labelPlural}" value!="{c.total}" hint!="{c.published + ' live' + (c.review ? ' · ' + c.review + ' in review' : '')}" href!="{'/admin/content/' + c.ct.id}" icon!="{c.ct.icon}")
		+if('data.media !== null')
			Stat(label="Media" value!="{data.media}" href="/admin/media" icon="lucide:image")
		+if('data.users')
			Stat(label="People" value!="{data.users.staff + data.users.clients}" hint!="{data.users.staff + ' staff · ' + data.users.clients + ' members'}" href="/admin/users" icon="lucide:users")
		+if('data.consent')
			Stat(label="Consent choices (30 days)" value!="{data.consent.total}" hint!="{data.consent.total ? data.consent.analyticsRate + '% allow analytics' : 'No choices recorded yet'}" href="/admin/consent" icon="lucide:cookie")
		+if('data.notFound !== null')
			Stat(label="404 paths" value!="{data.notFound}" hint="Missing pages people hit" href="/admin/seo#not-found" icon="lucide:file-question")
	+if('data.review.length')
		section.space-y-3
			h2.text-lg.font-semibold Waiting for review
			EntryList(entries!="{data.review}")
	+if('data.scheduled.length')
		section.space-y-3
			h2.text-lg.font-semibold Scheduled
			EntryList(entries!="{data.scheduled}" showDate)
	+if('data.mine.length')
		section.space-y-3
			h2.text-lg.font-semibold Your entries
			EntryList(entries!="{data.mine}")
	section.space-y-3
		h2.text-lg.font-semibold Recently updated
		+if('data.recent.length === 0')
			EmptyState(icon="lucide:sparkles" title="Nothing yet") Create your first page or article from the sidebar.
		+else
			EntryList(entries!="{data.recent}")

<script>
	import EntryList from '$lib/norns/content/ui/EntryList.n'
	{ data } := $props()
</script>
