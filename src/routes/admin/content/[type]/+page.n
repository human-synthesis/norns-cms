.space-y-6
	PageHead(title!="{data.ct.labelPlural}" subtitle!="{data.tabs[0].count + ' total'}")
		+snippet('actions')
			+if('data.canCreate')
				Btn(href!="{'/admin/content/' + data.ct.id + '/new' + (data.lang ? '?lang=' + data.lang : '')}" variant="primary" icon="lucide:plus") New {data.ct.label}{data.lang ? ' (' + data.lang + ')' : ''}
	nav.filter-tabs(aria-label="Status")
		+each('data.tabs as t (t.id)')
			a.filter-tab(href!="{tabHref(t.id)}" class!="{data.status === t.id ? 'filter-tab-active' : ''}") {t.label}
				span.filter-count {t.count}
	form.flex.flex-wrap.items-end.gap-2(method="GET")
		input(type="hidden" name="status" value!="{data.status}")
		Input(name="q" value!="{data.q}" placeholder="Search titles and slugs…" class="w-64")
		+if('data.languages.length > 1')
			Select(name="lang" value!="{data.lang}" class="w-40")
				option(value="") All languages
				+each('data.languages as l (l)')
					option(value!="{l}") {l}
		label.check-item
			Checkbox(name="mine" value="1" checked!="{data.mine}")
			span Only mine
		Btn(type="submit" variant="secondary" icon="lucide:filter") Filter
	DataTable(columns!="{columns}" rows!="{rows}" onrowclick!="{open}" emptyMessage="Nothing here yet.")
	+if('data.pages > 1')
		.flex.items-center.justify-between.text-sm
			span(class="text-fg-muted") Page {data.page} of {data.pages}
			.flex.gap-2
				+if('data.page > 1')
					Btn(href!="{pageHref(data.page - 1)}" variant="secondary" size="sm") Previous
				+if('data.page < data.pages')
					Btn(href!="{pageHref(data.page + 1)}" variant="secondary" size="sm") Next

<script>
	import { goto } from '$app/navigation'
	import { page } from '$app/state'
	import { displayStatus } from '$lib/norns/content/shared/types'
	{ data } := $props()

	columns := $derived [
		{ key: 'title', label: 'Title' }
		...(data.languages.length > 1 ? [{ key: 'locale', label: 'Language' }, { key: 'coverage', label: 'Translations' }] : [])
		{ key: 'slug', label: 'URL', class: 'text-fg-muted' }
		{ key: 'status', label: 'Status' }
		{ key: 'updated', label: 'Updated' }
	]

	rows := $derived.by =>
		data.entries.map (e) => ({
			id: e.id
			title: e.title || '(untitled)'
			locale: e.locale
			coverage: data.languages.map((l) => ((data.coverage[e.translation_group] ?? []).includes(l) ? '● ' : '○ ') + l).join('  ')
			slug: (data.ct.basePath || '') + '/' + e.slug
			status: displayStatus(e).replace('_', ' ') + (e.visibility === 'members' ? ' · members' : '')
			updated: new Date(e.updated_at).toLocaleString()
		})

	open := (row) => goto('/admin/content/' + data.ct.id + '/' + row.id)

	tabHref := (id) =>
		u := new URL(page.url)
		if id
			u.searchParams.set 'status', id
		else
			u.searchParams.delete 'status'
		u.searchParams.delete 'page'
		u.pathname + u.search

	pageHref := (n) =>
		u := new URL(page.url)
		u.searchParams.set 'page', String(n)
		u.pathname + u.search
</script>
