.auth-page
	Card(class="auth-card")
		.space-y-6
			.flex.items-center.gap-3
				.logo-mark {data.siteTitle.slice(0, 1)}
				div
					.font-bold.tracking-tight {data.siteTitle}
					.text-xs(class="text-fg-muted") Sign in
			+if('data.reset')
				Banner(variant="success" icon="lucide:check") Password changed. Sign in with the new one.
			Form(action="?/login" form!="{form}")
				.space-y-4
					input(type="hidden" name="next" value!="{data.next}")
					Field(label="Email" name="email" required)
						Input(type="email" name="email" value!="{form?.values?.email ?? ''}" autocomplete="username" required)
					Field(label="Password" name="password" required)
						Input(type="password" name="password" autocomplete="current-password" required)
					FormGuard(id="auth.staff-login" form!="{form}")
					Btn(type="submit" variant="primary" class="w-full") Sign in
			.text-sm.text-center
				a(href="/login/forgot") Forgot your password?

<script>
	import FormGuard from '$lib/norns/protection/ui/FormGuard.n'
	{ data, form } := $props()
</script>
