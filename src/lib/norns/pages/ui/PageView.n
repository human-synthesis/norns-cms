article.page-view
	+if('res.entry.status !== "published" || res.entry.published_at > Date.now()')
		Banner(variant="warning" icon="lucide:eye") {t(res.entry.status === 'published' ? 'preview.scheduled' : (res.entry.status === 'in_review' ? 'preview.review' : 'preview.draft'))}
	+if('fallbackName')
		Banner(variant="info" icon="lucide:languages") {t('preview.fallback', { language: fallbackName })}
	+if('!res.entry.data.hideTitle')
		header.page-header
			h1.page-title {res.entry.title}
	+if('res.locked')
		MembersOnly(summary!="{res.entry.data.summary}")
	+elseif('res.entry.data.layout === "blocks"')
		.blocks
			BlockRenderer(blocks!="{res.blocks}" media!="{res.media}")
	+else
		.prose
			| {@html res.html.body ?? ''}

<script>
	import { t } from '../../i18n/ui/t.js'
	import BlockRenderer from './BlockRenderer.n'
	import MembersOnly from '../../articles/ui/MembersOnly.n'
	{ res, fallbackName = null } := $props()
</script>
