section.block-cookies
	+if('props.title')
		h2 {props.title}
	+each('data?.declaration?.groups ?? [] as g (g.id)')
		.cookie-group
			h3 {g.label}
			p {g.text}
			+if('g.cookies.length')
				.table-wrap
					table.cookie-table
						thead
							tr
								th {t('cookies.cookie')}
								th {t('cookies.service')}
								th {t('cookies.lasts')}
								th {t('cookies.purpose')}
						tbody
							+each('g.cookies as ck, i (i)')
								tr
									td
										code {ck.name}
									td {ck.service ?? ''}
									td {ck.duration}
									td {ck.purpose}
			+else
				p.text-sm(class="text-fg-muted") {t('cookies.none')}
	+if('props.showButton')
		Btn(variant="secondary" icon="lucide:cookie" onclick!="{openSettings}") {t('footer.cookieSettings')}

<script>
	import { t } from '../../i18n/ui/t.js'
	{ props = {}, data = null } := $props()
	openSettings := => window.dispatchEvent(new CustomEvent('cms:open-consent'))
</script>
