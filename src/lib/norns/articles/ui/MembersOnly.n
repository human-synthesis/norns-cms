.members-only
	+if('summary')
		p.lede {summary}
	Card
		.space-y-3.text-center
			Icon(name="lucide:lock" size="size-6")
			p.font-semibold {t('members.title')}
			p.text-sm(class="text-fg-muted") {t('members.text')}
			.flex.justify-center.gap-2
				Btn(href!="{'/account/login?next=' + encodeURIComponent(page.url.pathname)}" variant="primary") {t('members.signIn')}
				+if('page.data.site?.registration === "open"')
					Btn(href="/account/register" variant="secondary") {t('members.register')}

<script>
	import { t } from '../../i18n/ui/t.js'
	import { page } from '$app/state'
	{ summary = '' } := $props()
</script>
