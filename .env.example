# Copy to .env (gitignored). All optional.

# SQLite file; the same default `norns migrate` uses.
# DATABASE_URL=file:data/app.db

# Public site chrome.
# CMS_SITE_TITLE=My site
# CMS_SITE_TAGLINE=Notes, essays, and other things.

# First admin for `bun run cms:seed`.
# CMS_ADMIN_EMAIL=you@example.com
# CMS_ADMIN_PASSWORD=change-me

# Mail through Aiosis Emails (https://emails.aiosis.com), a key with the messages:send
# scope. Required in production; in dev and tests mail without a key is only logged
# (Admin → Logs → Mail log). MAIL_LOG_ONLY=true forces the log elsewhere.
# Senders: signup@ (invites, verification), signin@ (password reset),
# notification@ (team notices, form submissions), contact@ (contact form), all on
# MAIL_DOMAIN, or on Admin → Settings → Email → Mail domain when that is set.
# AIOSIS_API_KEY=sk_live_…
# MAIL_DOMAIN=example.com

# Absolute origin for emails, feeds, sitemaps and canonical URLs.
# CMS_PUBLIC_URL=https://example.com

# Encrypts two-factor secrets at rest; set in production.
# CMS_SECRET=

# Media directory when no R2 binding is present.
# MEDIA_DIR=data/media
