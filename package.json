{
  "name": "norns-cms",
  "version": "0.0.1",
  "description": "Content management system built on Norns (SvelteKit + Pug + Civet + norns-ui)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--preserve-symlinks' norns dev",
    "build": "NODE_OPTIONS='--preserve-symlinks' norns build && bun tools/worker-cron.js",
    "preview": "wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "norns check",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "lint": "norns lint",
    "test": "bun test",
    "db:migrate": "wrangler d1 migrations apply norns-cms --local",
    "db:migrate:remote": "wrangler d1 migrations apply norns-cms --remote",
    "db:seed": "bun tools/seed.js --d1",
    "db:seed:remote": "bun tools/seed.js --d1 --remote",
    "d1:sync": "bun tools/d1-sync.js",
    "migrate": "norns migrate",
    "cms:seed": "bun tools/seed.js",
    "deploy": "bun run build && wrangler d1 migrations apply norns-cms --remote && wrangler deploy",
    "domains": "bun tools/domains.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@human-synthesis/norns": "^0.0.20",
    "@human-synthesis/norns-core": "^0.0.12",
    "@human-synthesis/norns-ui": "^0.0.19",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4",
    "vite": "^8.0.12",
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@human-synthesis/norns-tron": "^0.0.3",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.0",
    "uqr": "^0.1.3",
    "valibot": "^1.4.0",
    "xss": "^1.0.17"
  }
}
