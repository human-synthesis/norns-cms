{
  "name": "norns-cms",
  "version": "0.0.1",
  "description": "Content management system built on Norns (SvelteKit + Pug + Civet + norns-ui)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--preserve-symlinks' norns dev",
    "build": "NODE_OPTIONS='--preserve-symlinks' norns build",
    "preview": "wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "norns check",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "lint": "norns lint",
    "test": "bun test",
    "db:migrate": "wrangler d1 migrations apply norns-cms --local",
    "db:migrate:remote": "wrangler d1 migrations apply norns-cms --remote",
    "db:seed": "bun tools/seed.js --d1",
    "db:seed:remote": "bun tools/seed.js --d1 --remote",
    "d1:sync": "bun tools/d1-sync.js",
    "migrate": "norns migrate",
    "cms:seed": "bun tools/seed.js",
    "deploy": "bun run build && wrangler d1 migrations apply norns-cms --remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@human-synthesis/norns": "^0.0.18",
    "@human-synthesis/norns-core": "^0.0.11",
    "@human-synthesis/norns-ui": "^0.0.13",
    "@sveltejs/adapter-cloudflare": "^7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^4",
    "@tailwindcss/vite": "^4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4",
    "vite": "^5.4.0",
    "wrangler": "^4"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@human-synthesis/norns-tron": "^0.0.2",
    "marked": "^15.0.0",
    "valibot": "^1.4.0"
  }
}
